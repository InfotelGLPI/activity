{% import 'components/form/fields_macros.html.twig' as fields %}

{#
 # Plugin options, a single record (id 1). The blocks carrying data-activity-toggle are
 # shown only while the matching yes/no selector is on "yes" (public/scripts/option-form.js).
 #}
{% set row = {'field_class': 'col-12', 'label_class': 'col-sm-5', 'input_class': 'col-sm-7'} %}

<form name="form" method="post" action="{{ form_url }}" enctype="multipart/form-data">
    <input type="hidden" name="id" value="1">

    {# --- CRA --- #}
    <div class="card mb-3">
        <div class="card-header d-flex align-items-center gap-2">
            <i class="ti ti-calendar-stats"></i>
            <strong>{{ __('CRA', 'activity') }}</strong>
        </div>
        <div class="card-body">
            <div class="row">
                {{ fields.dropdownYesNo('use_type_as_name', values.use_type_as_name, __('Replace activity name by the activity type', 'activity'), row) }}
                {{ fields.dropdownYesNo('is_cra_default', values.is_cra_default, __('is on CRA by default', 'activity'), row) }}
                {{ fields.dropdownYesNo('use_hour_on_cra', values.use_hour_on_cra, __('Use hour on cra and not half day', 'activity'), row) }}
                {{ fields.dropdownYesNo('use_planning_activity_hours', values.use_planning_activity_hours, __('Use the planning activity hours to limit hours per day on the CRA', 'activity'), row) }}
                {{ fields.dropdownYesNo('use_planningeventsubcategories', values.use_planningeventsubcategories, __('Use event subcategories', 'activity'), row) }}
                {{ fields.dropdownYesNo('show_planningevents_entity', values.show_planningevents_entity, __('Show event entity on CRA', 'activity'), row) }}
                {{ fields.dropdownYesNo('show_planningevents_project', values.show_planningevents_project, __('Choose your project when entering externals events and display on CRA', 'activity'), row) }}
                {{ fields.dropdownYesNo('use_project', values.use_project, __('Use projects', 'activity'), row) }}
                {{ fields.dropdownYesNo('is_cra_default_project', values.is_cra_default_project, __('is on CRA by default', 'activity') ~ ' - ' ~ project_typename, row|merge({
                    'add_field_attribs': {'data-activity-toggle': 'use_project', 'style': values.use_project ? '' : 'display: none'},
                })) }}
                {{ fields.textField('principal_client', values.principal_client, __('Principal client', 'activity'), row) }}

                {% if logo_preview_url %}
                    {% set logo_preview %}
                        <img src="{{ logo_preview_url }}" alt="{{ __('Current logo', 'activity') }}"
                             style="max-height:80px; max-width:250px; border:1px solid #dee2e6; border-radius:4px; padding:4px; background:#fff;">
                    {% endset %}
                    {# htmlField: markup built just above from an escaped URL #}
                    {{ fields.htmlField('', logo_preview, __('Current logo', 'activity'), row) }}
                {% endif %}
                {% if canedit %}
                    {# The upload must keep the name "filename": Option::prepareInput() reads _filename #}
                    {{ fields.fileField('filename', null, __('CRA logo', 'activity'), row|merge({
                        'multiple': false,
                        'onlyimages': true,
                        'helper': __('Accepted formats: JPG or JPEG. Leave empty to keep the current logo.', 'activity'),
                    })) }}
                {% endif %}

                {{ fields.textareaField('cra_footer', values.cra_footer, __('CRA Footer', 'activity'), row|merge({'rows': 5})) }}
            </div>
        </div>
    </div>

    {# --- Planning --- #}
    <div class="card mb-3">
        <div class="card-header d-flex align-items-center gap-2">
            <i class="ti ti-clock"></i>
            <strong>{{ __('Planning', 'activity') }}</strong>
        </div>
        <div class="card-body">
            <div class="row">
                {{ fields.dropdownYesNo('use_timerepartition', values.use_timerepartition, __('Use time repartition', 'activity'), row) }}
                {{ fields.dropdownYesNo('use_mandaydisplay', values.use_mandaydisplay, __('Use the view by day men in planning', 'activity'), row|merge({
                    'add_field_attribs': {'data-activity-toggle': 'use_timerepartition', 'style': values.use_timerepartition ? '' : 'display: none'},
                })) }}
                {{ fields.dropdownYesNo('use_pairs', values.use_pairs, __('Use pairs schedules', 'activity'), row) }}
                {{ fields.dropdownYesNo('use_integerschedules', values.use_integerschedules, __('Authorize only the whole schedules', 'activity'), row) }}
                {{ fields.dropdownYesNo('use_weekend', values.use_weekend, __('Authorize activities on week-ends', 'activity'), row) }}
            </div>
        </div>
    </div>

    {# --- Holidays --- #}
    <div class="card mb-3">
        <div class="card-header d-flex align-items-center gap-2">
            <i class="ti ti-beach"></i>
            <strong>{{ __('Holidays', 'activity') }}</strong>
        </div>
        <div class="card-body">
            <div class="row">
                {{ fields.dropdownYesNo('use_groupmanager', values.use_groupmanager, __('Use group manager as holiday manager', 'activity'), row) }}
                {{ fields.dropdownNumberField('default_validation_percent', values.default_validation_percent, __('Default validation percent', 'activity'), row|merge({
                    'min': 0,
                    'max': 100,
                    'step': 50,
                    'unit': '%',
                })) }}
                {{ fields.textField('used_mail_for_holidays', values.used_mail_for_holidays, __('Used mail for holidays', 'activity'), row) }}
            </div>
        </div>
        <div class="card-footer d-flex justify-content-end">
            {% if canedit %}
                <button type="submit" name="update" class="btn btn-primary">
                    <i class="ti ti-device-floppy me-1"></i>{{ _x('button', 'Save') }}
                </button>
            {% endif %}
        </div>
    </div>
</form>
