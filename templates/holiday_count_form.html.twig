<tr class="tab_bg_1">
    <td>{{ _n('User', 'Users', 1) }}</td>
    <td>
        {{ username }}
        <input type="hidden" name="users_id" value="{{ users_id }}">
    </td>
    <td>{{ holiday_type_label }}</td>
    <td>{{ holiday_type_dropdown_html|raw }}</td>
</tr>

<tr class="tab_bg_1">
    <td>{{ holiday_period_label }}</td>
    <td>{{ holiday_period_dropdown_html|raw }}</td>
    <td>{{ __('Counter', 'activity') }}</td>
    <td>
        <input type="text" name="count" class="form-control" size="14"
               value="{{ count }}">
    </td>
</tr>
