{% extends 'generic_show_form.html.twig' %}
{% import 'components/form/fields_macros.html.twig' as fields %}

{#
 # The user can only be chosen on a new counter, by the profiles allowed to grant one;
 # otherwise the target user is shown and posted as is.
 #}
{% block form_fields %}
    {% if user_selector %}
        {{ fields.dropdownField('User', 'users_id', users_id, _n('User', 'Users', 1), {
            'right': 'all',
        }) }}
    {% else %}
        {{ fields.readOnlyField('', username, _n('User', 'Users', 1)) }}
        {{ fields.hiddenField('users_id', users_id) }}
    {% endif %}

    {{ fields.dropdownField(holiday_type_class, 'plugin_activity_holidaytypes_id', item.fields['plugin_activity_holidaytypes_id'], holiday_type_class|itemtype_name, {
        'comments': true,
    }) }}

    {{ fields.dropdownField(holiday_period_class, 'plugin_activity_holidayperiods_id', item.fields['plugin_activity_holidayperiods_id'], holiday_period_class|itemtype_name, {
        'comments': true,
    }) }}

    {{ fields.textField('count', count, __('Counter', 'activity')) }}
{% endblock %}
