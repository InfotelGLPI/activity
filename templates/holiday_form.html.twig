{#
 # The holiday request form, on the core generic item form.
 #
 # Dates and half-day radios carry data-activity-duration: public/scripts/holiday-form.js
 # recomputes the duration when they change. The type, period and user selectors keep
 # the on_change of the legacy helpers of scripts-activityholidays.js, which target the
 # containers tr_plugin_activity_holidayperiods_id and tr_plugin_activity_details.
 #}
{% extends 'generic_show_form.html.twig' %}
{% import 'components/form/fields_macros.html.twig' as fields %}

{% block form_fields %}
    {% if from_planning_edit_ajax %}
        {{ fields.hiddenField('from_planning_edit_ajax', 1) }}
    {% endif %}

    {# --- Holiday type --- #}
    {% if is_existing %}
        {{ fields.readOnlyField('', holiday_type_name, holiday_type_class|itemtype_name) }}
    {% else %}
        {{ fields.dropdownField(holiday_type_class, 'plugin_activity_holidaytypes_id', item.fields['plugin_activity_holidaytypes_id'], holiday_type_class|itemtype_name, {
            'on_change': type_on_change,
        }) }}
    {% endif %}

    {# --- User --- #}
    {% if user_mode == 'new_selector' or user_mode == 'selector' %}
        {{ fields.dropdownField(user_class, 'users_id', users_id, _n('User', 'Users', 1), {
            'right': 'interface',
            'on_change': user_mode == 'new_selector' ? user_on_change : '',
        }) }}
    {% else %}
        {{ fields.readOnlyField('', user_name, _n('User', 'Users', 1)) }}
        {% if user_mode == 'hidden' %}
            {{ fields.hiddenField('users_id', users_id) }}
        {% endif %}
    {% endif %}

    {# --- Holiday period, shown for the types counted by period --- #}
    <div class="w-100"></div>
    {{ fields.dropdownField(holiday_period_class, 'plugin_activity_holidayperiods_id', item.fields['plugin_activity_holidayperiods_id'], holiday_period_class|itemtype_name, period_options|merge({
        'add_field_attribs': {'id': 'tr_plugin_activity_holidayperiods_id', 'style': show_period ? '' : 'display: none'},
    })) }}

    {# Remaining balance of the period, on the right of the period selector, filled by the helpers of scripts-activityholidays.js #}
    <div id="tr_plugin_activity_details" class="col-12 col-sm-6 d-flex align-items-center"></div>

    {# --- Dates, begin and end side by side on a row of their own --- #}
    <div class="w-100"></div>
    {% if is_existing %}
        {{ fields.readOnlyField('', begin_display, __('Start date')) }}
        {{ fields.readOnlyField('', end_display, __('End date')) }}
    {% else %}
        {{ fields.hiddenField('is_planned', 1) }}
        {{ fields.hiddenField('actiontime', actiontime_days, {'id': 'actiontime'}) }}
        {% for bound in [
            {'name': 'begin', 'label': __('Start date'), 'cbs': cbs_begin, 'radio': 'radio_cb_begindate'},
            {'name': 'end', 'label': __('End date'), 'cbs': cbs_end, 'radio': 'radio_cb_enddate'},
        ] %}
            {% set half_days %}
                <div class="d-flex flex-wrap gap-3 mt-2">
                    {% for cb in bound.cbs %}
                        <label class="form-check form-check-inline mb-0" for="{{ cb.cb_id }}">
                            <input class="form-check-input" type="radio" name="{{ bound.radio }}"
                                   id="{{ cb.cb_id }}" value="{{ cb.value }}" data-activity-duration
                                   {{ cb.checked ? 'checked' }} {{ cb.disabled ? 'disabled' }}>
                            <span class="form-check-label">{{ cb.title }}</span>
                        </label>
                    {% endfor %}
                </div>
            {% endset %}
            {{ fields.dateField(bound.name, null, bound.label, {
                'additional_attributes': {'data-activity-duration': ''},
                'add_field_html': half_days,
            }) }}
        {% endfor %}
    {% endif %}

    {# --- Duration, under the dates --- #}
    {% set duration_html %}
        <span id="div_duration" data-activity-webdir="{{ webdir }}">{{ duration }}</span>
        {{ period_lang }}
    {% endset %}
    {# raw: an escaped figure and label, built just above #}
    {{ fields.htmlField('', duration_html, __('Duration'), {'field_class': 'col-12'}) }}

    {# --- Comment --- #}
    {{ fields.textareaField('comment', item.fields['comment'], __('Description'), {
        'rows': 7,
        'disabled': is_existing,
        'field_class': 'col-12',
    }) }}
{% endblock %}
