<tr class="tab_bg_1">
    <td>

        <table width="100%">

            {# --- Holiday type --- #}
            <tr>
                <td>{{ holiday_type_label }}</td>
                <td>
                    {% if is_existing %}
                        {{ holiday_type_name|e }}
                    {% else %}
                        {{ holiday_type_dropdown_html|raw }}
                    {% endif %}
                </td>
            </tr>

            {# --- Holiday period --- #}
            <tr id="tr_plugin_activity_holidayperiods_id"
                {% if not show_period %}style="display:none"{% endif %}>
                <td>{{ holiday_period_label }}</td>
                <td>{{ holiday_period_dropdown_html|raw }}</td>
            </tr>

            {# --- Begin date --- #}
            <tr>
                <td>{{ __('Start date') }}</td>
                <td>
                    {% if not is_existing %}
                        <input type="hidden" name="is_planned" value="1">
                        <input type="hidden" name="actiontime" id="actiontime" value="{{ actiontime_days }}">
                        {{ begin_date_html|raw }}
                    {% else %}
                        <input class="form-control" disabled="disabled" value="{{ begin_display }}">
                    {% endif %}
                </td>
            </tr>

            {% if not is_existing %}
            <tr>
                <td>&nbsp;</td>
                <td>
                    {% for cb in cbs_begin %}
                        <label for="{{ cb.cb_id }}">
                            <input type="radio"
                                   name="radio_cb_begindate"
                                   id="{{ cb.cb_id }}"
                                   value="{{ cb.value }}"
                                   {% if cb.checked %}checked="checked"{% endif %}
                                   {% if cb.disabled %}disabled="disabled"{% endif %}
                                   onclick="{{ cb.onclick }}">
                            &nbsp;{{ cb.title }}
                        </label>&nbsp;&nbsp;
                        {% if loop.index == 2 %}<br>{% endif %}
                    {% endfor %}
                </td>
            </tr>
            {% endif %}

            {# --- End date --- #}
            <tr>
                <td>{{ __('End date') }}</td>
                <td>
                    {% if not is_existing %}
                        {{ end_date_html|raw }}
                    {% else %}
                        <input class="form-control" disabled="disabled" value="{{ end_display }}">
                    {% endif %}
                </td>
            </tr>

            {% if not is_existing %}
            <tr>
                <td>&nbsp;</td>
                <td>
                    {% for cb in cbs_end %}
                        <label for="{{ cb.cb_id }}">
                            <input type="radio"
                                   name="radio_cb_enddate"
                                   id="{{ cb.cb_id }}"
                                   value="{{ cb.value }}"
                                   {% if cb.checked %}checked="checked"{% endif %}
                                   {% if cb.disabled %}disabled="disabled"{% endif %}
                                   onclick="{{ cb.onclick }}">
                            &nbsp;{{ cb.title }}
                        </label>&nbsp;&nbsp;
                        {% if loop.index == 2 %}<br>{% endif %}
                    {% endfor %}
                </td>
            </tr>
            {% endif %}

            {# --- Duration --- #}
            <tr>
                <td>{{ __('Duration') }}</td>
                <td>
                    <div id="div_duration">{{ duration_html|raw }}</div>
                    {{ period_lang|e }}
                </td>
            </tr>

        </table>

    </td>

    <td align="left" valign="top">

        <table width="100%">

            {# --- User --- #}
            <tr class="tab_bg_2">
                <td>{{ _n('User', 'Users', 1) }}</td>
            </tr>
            <tr>
                <td>
                    {% if user_dropdown_html %}
                        {{ user_dropdown_html|raw }}
                    {% else %}
                        {{ user_name }}
                        {{ users_id_hidden|raw }}
                    {% endif %}
                </td>
            </tr>

            {# --- Comment --- #}
            <tr class="tab_bg_2">
                <td>{{ __('Description') }}</td>
            </tr>
            <tr>
                <td>{{ comment_textarea_html|raw }}</td>
            </tr>

        </table>

    </td>
</tr>

{# --- Action buttons (existing item) --- #}
{% if is_existing %}
    {% if can_purge_as_manager %}
        <tr class="tab_bg_2">
            <td class="right" colspan="4">
                <button type="submit" name="purge" class="btn btn-primary"
                        onclick="return confirm('{{ __('Confirm the final deletion?')|e('js') }}')">
                    {{ _x('button', 'Delete permanently') }}
                </button>
                <input type="hidden" name="id" value="{{ id }}">
            </td>
        </tr>
    {% endif %}
{% else %}
    {# New item: warn if no manager --- #}
    {% if not has_manager %}
        <tr>
            <td colspan="4">
                <div class="alert alert-warning">
                    <p>{{ __("You don't have any manager filled in you personal settings.", 'activity') }}</p>
                    <p>{{ __("In order to make a holiday demand, please fill at least one manager in your personal settings", 'activity') }}</p>
                    <p>
                        {{ __("See the page", 'activity') }}
                        <a href="{{ preference_url }}" target="_blank">{{ __('My settings') }}</a>
                    </p>
                </div>
            </td>
        </tr>
    {% endif %}
{% endif %}
