{% if widget %}
    <div class="d-flex flex-wrap justify-content-center gap-3">
        {% for action in actions %}
            <div class="nb">{{ _self.action_link(action) }}</div>
        {% endfor %}
    </div>
{% else %}
    <div class="center">
        <table class="tab_cadre_fixe activity_menu" style="width: 400px;">
            <tr><th colspan="2">{{ title }}</th></tr>
            {% for pair in actions|batch(2) %}
                <tr class="twhite">
                    {% for action in pair %}
                        <td class="center">{{ _self.action_link(action) }}</td>
                    {% endfor %}
                    {% if pair|length == 1 and actions|length > 1 %}
                        <td></td>
                    {% endif %}
                </tr>
            {% endfor %}
        </table>
    </div>
{% endif %}

{% macro action_link(action) %}
    <a href="{{ action.link }}"
       {% if action.modal is defined and action.modal is not empty %}data-bs-toggle="modal" data-bs-target="#{{ action.modal }}"{% endif %}>
        <i class="{{ action.img }}" style="font-size: 3.5em;" title="{{ action.label }}"></i>
        <br><br>{{ action.label }}
    </a>
{% endmacro %}
