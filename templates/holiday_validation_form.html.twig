{#
 # Approval panel of a holiday validation, rendered standalone (not through
 # generic_show_form): it is not an item form but an accept/refuse action for the
 # designated validator, also loaded through ajax/viewsubvalidation.php.
 #
 # front/holidayvalidation.form.php only acts on a post carrying `update`, then
 # reads `accept_holiday` / `refuse_holiday` from the name of the clicked button.
 #}
{% import 'components/form/fields_macros.html.twig' as fields %}

{% set can_answer = is_validator and status_waiting %}

<div class="card-body">
    {% if can_answer %}
        <form id="{{ form_id }}" method="post" action="{{ item.getFormURL() }}" data-submit-once>
            <input type="hidden" name="id" value="{{ item.getID() }}">
            <input type="hidden" name="update" value="1">
            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
    {% endif %}

    <div class="row">
        {% if can_answer %}
            <h3 class="col-12 mb-3">{{ __('Do you approve this holiday ?', 'activity') }}</h3>
        {% endif %}

        {% if not item.isNewItem() %}
            {% if is_validator %}
                {{ fields.textareaField('comment_validation', item.fields['comment_validation'], __('Approval comments'), {
                    'rows': 3,
                    'disabled': not can_answer,
                    'helper': __('Optional when approved'),
                    'field_class': 'col-12',
                }) }}
            {% else %}
                {{ fields.readOnlyField('', status_label, __('Status of the approval request')) }}
                {{ fields.readOnlyField('', item.fields['comment_validation'], __('Comments')) }}
            {% endif %}
        {% endif %}

        {{ fields.readOnlyField('', requester_name, __('Approval requester')) }}
        {{ fields.readOnlyField('', validator_name, __('Approver')) }}
    </div>

    {% if can_answer %}
            <div class="d-flex justify-content-center gap-2 mt-3">
                <button type="submit" name="accept_holiday" value="1" class="btn btn-success">
                    <i class="ti ti-circle-check"></i>
                    <span>{{ __('Accept holiday', 'activity') }}</span>
                </button>
                <button type="submit" name="refuse_holiday" value="1" class="btn btn-danger">
                    <i class="ti ti-circle-x"></i>
                    <span>{{ __('Refuse holiday', 'activity') }}</span>
                </button>
            </div>
        </form>
    {% endif %}
</div>
