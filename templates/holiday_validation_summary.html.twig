{#
 # Validation tab of a holiday: the approval options of the request (posted to
 # front/holiday.form.php), the action panel of every validation waiting for the
 # current user, then the list of the validations.
 #
 # The options panel is folded with a Bootstrap collapse, no script needed.
 #}
{% import 'components/form/fields_macros.html.twig' as fields %}

{% set options_id = 'plugin_activity_validation_options_' ~ holiday_id %}

<div class="mb-3">
    <button type="button" class="btn btn-link px-0" data-bs-toggle="collapse"
            data-bs-target="#{{ options_id }}" aria-expanded="false" aria-controls="{{ options_id }}">
        {{ __('See validation options', 'activity') }}
        <i class="ti ti-chevrons-down ms-1"></i>
    </button>

    <div id="{{ options_id }}" class="collapse">
        <form method="post" action="{{ form_url }}" data-submit-once>
            <div class="card">
                <div class="card-header"><h4 class="card-title">{{ typename }}</h4></div>
                <div class="card-body">
                    <div class="row">
                        {{ fields.dropdownArrayField('global_validation', global_validation, status_choices, __('Global approval status')) }}
                        {{ fields.readOnlyField('', validation_stats, _x('item', 'State')) }}
                        {{ fields.dropdownNumberField('validation_percent', validation_percent, __('Minimum approval required (%)'), {
                            'min': 0,
                            'max': 100,
                            'step': 50,
                            'unit': '%',
                        }) }}
                    </div>
                </div>
                <div class="card-footer text-end">
                    <input type="hidden" name="id" value="{{ holiday_id }}">
                    <button type="submit" name="update" value="1" class="btn btn-primary">
                        <i class="ti ti-device-floppy"></i>
                        <span>{{ _x('button', 'Save') }}</span>
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

{# --- Action panel of the validations waiting for the current user --- #}
{% for validator_form in validator_forms %}
    <div class="card mb-3">
        {{ include('@activity/holiday_validation_form.html.twig', validator_form, with_context = false) }}
    </div>
{% endfor %}

{# --- Validation list --- #}
{% if validations|length > 0 %}
    <table class="table table-hover card-table">
        <thead>
            <tr>
                <th colspan="5">
                    {{ _n('Validation for this holiday', 'Validations for this holiday', validations|length, 'activity') }}
                </th>
            </tr>
            <tr>
                <th>{{ _x('item', 'State') }}</th>
                <th>{{ __('Request') ~ ': ' ~ __('Date') }}</th>
                <th>{{ __('Approval date') }}</th>
                <th>{{ __('Approver') }}</th>
                <th>{{ __('Approval') ~ ': ' ~ __('Comments') }}</th>
            </tr>
        </thead>
        <tbody>
            {% for row in validations %}
                <tr>
                    <td class="text-center">
                        {% if row.status == STATUS_ACCEPTED %}
                            <span class="badge bg-green-lt"><i class="ti ti-circle-check me-1"></i>{{ row.status_label }}</span>
                        {% elseif row.status == STATUS_REFUSED %}
                            <span class="badge bg-red-lt"><i class="ti ti-circle-x me-1"></i>{{ row.status_label }}</span>
                        {% else %}
                            <span class="badge bg-orange-lt"><i class="ti ti-question-mark me-1"></i>{{ row.status_label }}</span>
                        {% endif %}
                    </td>
                    <td>{{ row.submission_date }}</td>
                    <td>{{ row.validation_date }}</td>
                    <td>{{ row.validator_name }}</td>
                    <td>{{ row.comment_validation }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% else %}
    <div class="alert alert-info">{{ __('No holiday validation request found', 'activity') }}</div>
{% endif %}
