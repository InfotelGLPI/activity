<h3>
    <div class="alert alert-secondary" role="alert">
        <i class="ti ti-calendar"></i>&nbsp;{{ title }}
    </div>
</h3>

<table class="center" cellspacing="5" style="margin-left: auto; margin-right: auto;">
    <tr>
        {% for block in blocks %}
            {# Server-side markup built by PlanningExternalEvent::menu(). #}
            <td>{{ block|raw }}</td>
        {% endfor %}
    </tr>
</table>
