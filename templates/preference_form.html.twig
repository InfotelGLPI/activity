<div class="card mb-3">
    <div class="card-header d-flex align-items-center gap-2">
        <i class="ti ti-users"></i>
        <strong>{{ __('List of my managers', 'activity') }}</strong>
    </div>
    <div class="card-body p-0">

        {% if use_groupmanager == 0 %}
            {# Mode manual: managers declared by the user #}
            <form method="post" action="{{ form_url }}">
                <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            {% if managers|length == 0 %}
                                <th>{{ __('List of my managers', 'activity') }}</th>
                            {% else %}
                                <th>{{ _n('User', 'Users', 1) }}</th>
                                <th>{{ _n('Action', 'Actions', 1) }}</th>
                            {% endif %}
                        </tr>
                    </thead>
                    <tbody>
                        {% if managers|length == 0 %}
                            <tr id="no_manager_left">
                                <td>{{ __('You have not declared any manager yet.', 'activity') }}</td>
                            </tr>
                        {% else %}
                            {% for manager in managers %}
                                <tr>
                                    <td>{{ manager.username }}</td>
                                    <td>
                                        <input type="hidden" name="id" value="{{ manager.id }}">
                                        <button type="submit" name="delete" class="btn btn-sm btn-danger">
                                            <i class="ti ti-trash me-1"></i>{{ _x('button', 'Delete permanently') }}
                                        </button>
                                    </td>
                                </tr>
                            {% endfor %}
                        {% endif %}
                    </tbody>
                </table>
            </form>

        {% else %}
            {# Mode group manager: managers come from group membership #}
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>{{ _n('User', 'Users', managers|length) }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% if managers|length == 0 %}
                        <tr id="no_manager_left">
                            <td>{{ __('There is no manager for your groups', 'activity') }}</td>
                        </tr>
                    {% else %}
                        {% for manager in managers %}
                            <tr>
                                <td>{{ manager.username }}</td>
                            </tr>
                        {% endfor %}
                    {% endif %}
                </tbody>
            </table>

        {% endif %}

    </div>
</div>
