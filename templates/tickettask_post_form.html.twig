{% import 'components/form/fields_macros.html.twig' as fields %}

{% if can_use_cra %}
    <div class="row justify-content-end">
        {{ fields.dropdownYesNo('is_oncra', is_oncra_value, __('Use in CRA', 'activity'), {
            'field_class': 'col-auto',
            'label_class': 'col-auto',
            'input_class': 'col-auto',
        }) }}
    </div>
{% else %}
    <input type="hidden" name="is_oncra" value="1">
{% endif %}
