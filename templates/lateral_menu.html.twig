<div class="d-grid gap-2 mb-3">
    {% for action in actions %}
        <a href="{{ action.link }}" class="btn btn-info"
           {% if action.onclick %}{{ action.onclick|raw }}{% endif %}>
            {{ action.label }}
        </a>
    {% endfor %}
</div>

{% if holidays_summary is not empty %}
    <table class="tab_cadre" width="100%">
        {% if holidays_summary.has_data %}
            <tr class="tab_bg_1">
                <td colspan="2"><b>{{ __('Remaining holidays', 'activity') }} : </b></td>
            </tr>
            {% for row in holidays_summary.rows %}
                {% if row.type == 'period_header' %}
                    <tr>
                        <td colspan="2">{{ row.label }}</td>
                    </tr>
                {% elseif row.type == 'period_detail' %}
                    <tr>
                        <td>
                            <span class="activity_tree"></span>
                            {{ __('Valid until', 'activity') }}&nbsp;{{ row.end_date }}
                        </td>
                        <td>{{ row.count }}</td>
                    </tr>
                {% elseif row.type == 'total' %}
                    <tr>
                        <td>{{ __('Cumul', 'activity') }}</td>
                        <td>{{ row.count }}</td>
                    </tr>
                {% endif %}
            {% endfor %}
        {% endif %}
    </table>
{% endif %}
