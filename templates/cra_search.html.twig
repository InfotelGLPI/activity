<div class="card mb-3">
    <div class="card-header d-flex align-items-center gap-2">
        <i class="ti ti-calendar-stats"></i>
        <strong>{{ __('Activity report', 'activity') }}</strong>
    </div>
    <div class="card-body">
        {# data-submit-once: the report is slow to compute, a second click would start a second computation #}
        <form method="post" id="form_cra" name="form" action="cra.php" data-submit-once>
            <div class="row g-3 align-items-end">
                <div class="col-auto">
                    {# Handled by public/scripts/cra-search.js #}
                    <button type="button" class="btn btn-outline-secondary" data-activity-month-step="-1">
                        <i class="ti ti-chevron-left me-1"></i>{{ __('Previous month', 'activity') }}
                    </button>
                </div>
                <div class="col-auto">
                    <label class="col-form-label fw-bold">{{ __('Date') }}</label>
                </div>
                <div class="col-auto">
                    <select class="form-select" name="month" aria-label="{{ _n('Month', 'Months', 1) }}">
                        {% for key, label in months %}
                            <option value="{{ key }}" {{ key == month ? 'selected' : '' }}>{{ label }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-auto">
                    <select class="form-select" name="year" aria-label="{{ _n('Year', 'Years', 1) }}">
                        {% for y in years %}
                            <option value="{{ y }}" {{ y == year ? 'selected' : '' }}>{{ y }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-auto">
                    <button type="button" class="btn btn-outline-secondary" data-activity-month-step="1">
                        {{ __('Next month', 'activity') }}<i class="ti ti-chevron-right ms-1"></i>
                    </button>
                </div>
                {% if can_see_all_users %}
                <div class="col-auto">
                    {% do call('User::dropdown', [user_dropdown_options]) %}
                </div>
                {% else %}
                    <input type="hidden" name="users_id" value="{{ users_id }}">
                {% endif %}
                <div class="col-auto">
                    <button type="submit" name="submit" class="btn btn-primary">
                        <i class="ti ti-search me-1"></i>{{ __('Post', 'activity') }}
                    </button>
                </div>
            </div>
        </form>
    </div>

    <div class="card-footer d-flex gap-2 align-items-center flex-wrap">
        {# Export PDF #}
        <form method="POST" action="cra.php" class="d-inline-flex align-items-center gap-2">
            {% for name, value in export_hidden_fields %}
                <input type="hidden" name="{{ name }}" value="{{ value }}">
            {% endfor %}
            <select class="form-select" name="display_type">
                <option value="{{ pdf_output_type }}">{{ __('Export CRA', 'activity') }}</option>
            </select>
            <button type="submit" name="export" class="btn btn-primary" title="{{ _x('button', 'Export') }}">
                <i class="ti ti-device-floppy"></i><span class="visually-hidden">{{ _x('button', 'Export') }}</span>
            </button>
        </form>

        {# Snapshot trigger #}
        <form method="POST" action="cra.php" class="d-inline-flex align-items-center gap-2">
            {% for name, value in snapshot_hidden_fields %}
                <input type="hidden" name="{{ name }}" value="{{ value }}">
            {% endfor %}
            <button type="submit" name="submit" class="btn btn-outline-secondary">
                <i class="ti ti-camera me-1"></i>{{ __('Take a snapshot of the CRA', 'activity') }}
            </button>
        </form>
    </div>
</div>
