{% import 'components/form/fields_macros.html.twig' as fields %}
{% set row = {'field_class': 'col-12', 'label_class': 'col-2', 'input_class': 'col-10'} %}

{% if can_use_cra or show_project %}
    <div class="row">
        {% if can_use_cra %}
            {{ fields.dropdownYesNo('is_oncra', is_oncra_value, __('Use in CRA', 'activity'), row) }}
        {% endif %}
        {% if show_project %}
            {{ fields.dropdownField('Project', 'projects_id', projects_id, __('Project'), row) }}
        {% endif %}
    </div>
{% endif %}
{% if not can_use_cra %}
    <input type="hidden" name="is_oncra" value="1">
{% endif %}

{% if use_subcategories %}
    {# Moved under the category row by public/scripts/planningexternalevent-subcategory.js #}
    <div class="d-none" data-activity-subcategory
         data-activity-subcategory-label="{{ subcategory_label }}"
         data-activity-subcategory-field-id="{{ field_id }}">
        {# raw: markup built by Dropdown::show() #}
        <div>{{ subcategory_dropdown_html|raw }}</div>
    </div>
{% endif %}
